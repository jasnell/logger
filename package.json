{
  "name": "@nodejs/logger",
  "version": "0.0.0",
  "description": "Structured logging facade for Node.js with pluggable providers",
  "license": "MIT",
  "author": "Node.js contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/logger.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs/logger/issues"
  },
  "homepage": "https://github.com/nodejs/logger#readme",
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "json",
    "diagnostics_channel"
  ],
  "main": "./lib/logger.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/logger.mjs",
      "require": "./lib/logger.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "types/index.d.ts"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/*.test.{js,mjs}\"",
    "test:types": "tsc -p test/types",
    "bench": "node benchmark/run.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino": "^10.4.0",
    "typescript": "^7.0.2"
  }
}
